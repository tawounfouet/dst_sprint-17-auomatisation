region       = "eu-west-3"
project_name = "dst-s17-wordpress"
environment  = "dev"

instance_type     = "t3.micro"
db_instance_class = "db.t3.micro"

# Optionnel : utiliser une paire de clés EC2 existante et limiter SSH à votre IP publique /32.
key_name = null
ssh_cidr = null

# Bonus HTTPS pédagogique avec certificat auto-signé.
enable_https = false

# Le sujet impose 10 GiB pour le volume EBS additionnel.
extra_ebs_size = 10

tags = {
  Owner   = "student"
  Purpose = "DataScientest-Sprint17"
}
