[Unit]
Description=DataScientest Celery Worker
After=network.target redis-server.service postgresql.service
Requires=redis-server.service

[Service]
Type=simple
User={{ django_system_user }}
Group={{ django_system_group }}
WorkingDirectory={{ django_install_dir }}
EnvironmentFile={{ django_environment_file }}
ExecStart={{ django_venv_dir }}/bin/celery -A {{ celery_app_module }} worker --loglevel={{ celery_loglevel }} --concurrency={{ celery_concurrency }} --hostname={{ celery_hostname }}
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
