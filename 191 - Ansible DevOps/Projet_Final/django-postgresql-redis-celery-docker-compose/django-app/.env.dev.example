# Development settings
DJANGO_SETTINGS_MODULE=config.settings.dev
APPLICATION_ENV=dev
APPLICATION_VERSION=0.0.0-dev
APPLICATION_COMMIT=local

DJANGO_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Leave DATABASE_URL undefined for DEV Lite SQLite fallback.
# Uncomment for DEV Full / PostgreSQL:
# DATABASE_URL=postgresql://django_app:CHANGE_ME_POSTGRES@localhost:5432/django_app

# Optional in DEV Lite. DEV Full Compose will inject authenticated Redis URLs.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_RESULT_EXPIRES=3600

# Object Storage configuration
# Set USE_S3_STORAGE=false (or leave undefined) for DEV Lite local filesystem storage.
# Set USE_S3_STORAGE=true for DEV Full MinIO:
USE_S3_STORAGE=false
# AWS_STORAGE_BUCKET_NAME=dst-media
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin12345
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ADDRESSING_STYLE=path
# AWS_S3_USE_SSL=false

DJANGO_LOG_LEVEL=DEBUG
