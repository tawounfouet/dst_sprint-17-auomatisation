# Production example only — never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.prod
APPLICATION_ENV=prod
APPLICATION_VERSION=CHANGE_ME_VERSION
APPLICATION_COMMIT=CHANGE_ME_COMMIT

DJANGO_SECRET_KEY=CHANGE_ME_PRODUCTION_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.invalid

DATABASE_URL=postgresql://django_app:CHANGE_ME_POSTGRES@db:5432/django_app
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS@redis:6379/1
CELERY_RESULT_EXPIRES=3600

# Object Storage (Managed Cloud S3 in PRODUCTION)
USE_S3_STORAGE=true
AWS_STORAGE_BUCKET_NAME=CHANGE_ME_PRODUCTION_BUCKET
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY
AWS_S3_REGION_NAME=eu-west-3
AWS_S3_ADDRESSING_STYLE=auto
AWS_S3_USE_SSL=true
# Optional S3 endpoint URL for alternative providers (e.g. Scaleway, Cloudflare R2, GCP):
# AWS_S3_ENDPOINT_URL=https://s3.eu-west-3.scw.cloud

DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_HSTS_SECONDS=31536000
