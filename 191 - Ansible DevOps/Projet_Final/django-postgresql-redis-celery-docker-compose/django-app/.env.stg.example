# Staging example only — never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.stg
APPLICATION_ENV=stg
APPLICATION_VERSION=0.0.0-stg
APPLICATION_COMMIT=CHANGE_ME_COMMIT

DJANGO_SECRET_KEY=CHANGE_ME_STAGING_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=stg.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://stg.example.invalid

DATABASE_URL=postgresql://django_app:CHANGE_ME_POSTGRES@db:5432/django_app
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS@redis:6379/1
CELERY_RESULT_EXPIRES=3600

# Object Storage (MinIO container in STAGING)
USE_S3_STORAGE=true
AWS_STORAGE_BUCKET_NAME=dst-media-stg
AWS_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_USE_SSL=false

DJANGO_LOG_LEVEL=INFO
